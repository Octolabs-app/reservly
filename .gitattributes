# Normalize all text files to LF in the repo and on checkout.
# Fixes the Prettier CRLF lint errors and keeps line endings stable
# across Windows/macOS/Linux and Cloudflare's Linux build.
* text=auto eol=lf

# Binary assets — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
