# ─── Local dev (Vite) ─────────────────────────────────────────────────────────
# When running `npm run dev`, the app uses the in-browser dev-store.
# No database credentials needed for local development.

VITE_SITE_URL=http://localhost:5173
SITE_URL=http://localhost:5173

# ─── Twilio WhatsApp ──────────────────────────────────────────────────────────
# Leave blank to run in "log-only" mode (messages are printed, not sent)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Leave blank to skip billing in local dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_STUDIO_MONTHLY=

# ─── Cloudflare (set in wrangler.toml or Cloudflare dashboard, NOT here) ─────
# DB, KV, and secrets are injected as CF bindings — never committed to .env
# See: CLOUDFLARE_SETUP.md
